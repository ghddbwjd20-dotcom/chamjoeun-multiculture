DATABASE_URL=postgresql://chamjoeun:CHANGE_ME@127.0.0.1:55432/chamjoeun
APP_URL=http://localhost:3000
# 실제 운영에서는 false. 개발환경에서만 이메일 인증 링크를 화면에 표시합니다.
DEV_EMAIL_PREVIEW=true
RESEND_API_KEY=
MAIL_FROM=
# 영상 연동 전에는 비워 둡니다. 수강권 검증 후 Worker 전용 서명 URL을 발급합니다.
VIDEO_GATEWAY_URL=
VIDEO_SIGNING_SECRET=

# Docker Compose 전용: DATABASE_URL과 같은 비밀번호를 설정
POSTGRES_PASSWORD=

NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 토스 웹훅 URL에 token 쿼리로 설정할 임의의 긴 비밀값
TOSS_WEBHOOK_TOKEN=
UPLOAD_DIR=.local/uploads

# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
VIDEO_STORAGE_CAP_GB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Public Kakao channel link, e.g. https://pf.kakao.com/_CHANNEL/chat
KAKAO_CHANNEL_URL=

# 외부 메시지는 키 설정 및 검증 후에만 활성화합니다.
NOTIFICATION_SENDING_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_PFID=
SOLAPI_ALIMTALK_TEMPLATE_ID=
# 이벤트별 문자(sms) 또는 알림톡(alimtalk). 빈 값이면 해당 채널 자동 발송 없음.
NOTIFY_SIGNUP_CHANNEL=
NOTIFY_ENROLLMENT_CHANNEL=
NOTIFY_PAYMENT_CHANNEL=
NOTIFY_COMPLETION_CHANNEL=
SOLAPI_TEMPLATE_SIGNUP=
SOLAPI_TEMPLATE_ENROLLMENT=
SOLAPI_TEMPLATE_PAYMENT=
SOLAPI_TEMPLATE_COMPLETION=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 운영 DB 백업은 직결 주소와 별도 보관 디렉터리를 사용합니다.
BACKUP_DATABASE_URL=
BACKUP_DIR=
