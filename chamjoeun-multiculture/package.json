{
  "name": "chamjoeun-multiculture",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/create-admin.ts",
    "db:local": "node --experimental-strip-types scripts/local-db.ts",
    "db:stop": "node --experimental-strip-types scripts/stop-db.ts",
    "db:seed:dev": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-development.ts",
    "test:integration": "node --env-file-if-exists=.env.local --experimental-strip-types --test tests/database.integration.ts",
    "worker:video": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/video-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@pdf-lib/fontkit": "1.1.1",
    "hls.js": "1.7.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.15.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "3.6.4",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.10",
    "typescript": "latest"
  },
  "type": "module"
}
